<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Registration_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Registration_Date__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Registration date cannot be in the future.</errorMessage>
</ValidationRule>
